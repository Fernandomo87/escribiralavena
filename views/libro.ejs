<%- include('partials/cabeza') %>
<main class="clara">
  <div class="wrap seccion">
    <div class="ficha-libro">
      <% if (libro.portada_id) { %><img src="/img/<%= libro.portada_id %>" alt="Portada de <%= libro.titulo %>"><% } %>
      <div class="ficha-texto">
        <span class="meta"><%= libro.categoria %><% if (libro.etiqueta) { %> <span class="chip" style="background:<%= libro.color %>"><%= libro.etiqueta %></span><% } %></span>
        <h1><%= libro.titulo %></h1>
        <% if (libro.cita) { %><p class="cita" style="margin:0;font-size:21px;color:<%= libro.color === '#1C1B19' ? '#8A6A00' : libro.color %>">«<%= libro.cita %>»</p><% } %>
        <div class="prosa" style="margin-top:0;font-size:18px"><%- md(libro.descripcion || libro.sinopsis) %></div>
        <% if (libro.boton_enlace) { %>
        <div class="acciones" style="margin-top:0">
          <a class="btn" style="background:<%= libro.color %>;color:<%= libro.color === '#1C1B19' ? '#F2C318' : '#fff' %>" href="<%= libro.boton_enlace %>" target="_blank" rel="noopener"><%= libro.boton_texto %><%= libro.precio ? ' · ' + libro.precio : '' %></a>
        </div>
        <% } %>
        <% const d = lineas(libro.ficha); if (d.length) { %>
        <dl class="datos"><% d.forEach(x => { %><dt><%= x.k %></dt><dd><%= x.v %></dd><% }) %></dl>
        <% } %>
        <% if (libro.adelanto && libro.adelanto.trim()) { %>
        <section class="adelanto" id="adelanto" aria-labelledby="adelanto-titulo">
          <input type="checkbox" id="adelanto-abrir" class="adelanto-check">
          <div class="adelanto-cabeza">
            <span class="eyebrow" style="color:<%= libro.color === '#1C1B19' ? '#8A6A00' : libro.color %>">Adelanto gratis</span>
            <h2 id="adelanto-titulo"><%= libro.adelanto_titulo || 'Lee el primer capítulo' %></h2>
          </div>
          <div class="adelanto-texto prosa"><%- parrafos(libro.adelanto) %></div>
          <label for="adelanto-abrir" class="btn btn-negro btn-chico adelanto-boton"><span class="ab-mas">Seguir leyendo</span><span class="ab-menos">Cerrar el capítulo</span></label>
        </section>
        <% } %>
        <a class="volver" href="/libros">← Todos los libros</a>
      </div>
    </div>
  </div>
</main>
<%- include('partials/pie') %>
