<%- include('_cabeza', { conEditor: true }) %>
<form method="post" action="/admin/paginas/<%= p.clave %>" enctype="multipart/form-data" class="editor-form">
  <input type="hidden" name="cuerpo" value="">
  <div class="barra-editor">
    <a href="/admin/paginas" class="volver-sutil">← Volver</a>
    <span class="sutil">Página: <b style="color:var(--carbon)"><%= p.titulo %></b></span>
    <span class="espacio"></span>
    <a class="link-simple" href="/<%= p.clave %>" target="_blank" rel="noopener">Ver en el sitio</a>
    <button class="btn btn-negro btn-chico" type="submit">Guardar</button>
  </div>
  <div class="campo"><label for="titulo">Título</label><input class="titulo-grande" type="text" id="titulo" name="titulo" value="<%= p.titulo %>" required></div>
  <div class="campo"><label for="bajada">Bajada</label><input type="text" id="bajada" name="bajada" value="<%= p.bajada %>"></div>
  <div class="campo">
    <label>Texto</label>
    <div class="editor-caja"><div id="editor" data-placeholder="Escribe aquí…"><%- html %></div></div>
    <div class="editor-info"><span id="contador"></span><span id="estado-editor" role="status"></span></div>
  </div>
  <div class="campo"><label for="imagen">Foto <span class="ayuda">(opcional; ideal para "Sobre mí")</span></label><input type="file" id="imagen" name="imagen" accept="image/jpeg,image/png,image/webp"></div>
  <% if (p.imagen_id) { %>
    <div style="display:flex;gap:16px;align-items:center;flex-wrap:wrap"><img class="miniatura" src="/img/<%= p.imagen_id %>" alt="Foto actual"><label class="check"><input type="checkbox" name="quitar_imagen"> Quitar foto</label></div>
  <% } %>
</form>
<%- include('_pie', { conEditor: true }) %>
