<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title><%= titulo %> · Panel · Escribir a la vena</title>
<link rel="icon" href="/logo.png" type="image/png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,500&family=Inter:wght@400;500;600&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/estilo.css?v=<%= v.css %>">
<% if (typeof conEditor !== 'undefined' && conEditor) { %><link rel="stylesheet" href="/vendor/quill.snow.css"><% } %>
</head>
<body class="cuerpo-admin">
<div class="adm">
  <aside class="adm-lateral">
    <a class="adm-marca" href="/admin"><img src="/logo.png" alt="" width="36" height="36"><span>Escribir a la vena</span></a>
    <nav class="adm-menu" aria-label="Panel">
      <% const items = [
        ['resumen', '/admin', 'Resumen', '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>'],
        ['cuentos', '/admin/cuentos', 'Cuentos', '<path d="M4 4h12l4 4v12H4z"/><path d="M8 10h8M8 14h8M8 18h5"/>'],
        ['libros', '/admin/libros', 'Libros', '<path d="M4 4h6a3 3 0 0 1 3 3v13a2 2 0 0 0-2-2H4zM20 4h-6a3 3 0 0 0-3 3v13a2 2 0 0 1 2-2h7z"/>'],
        ['paginas', '/admin/paginas', 'Páginas', '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h4"/>'],
      ]; items.forEach(([k, href, txt, ico]) => { %>
        <a href="<%= href %>" class="<%= seccion === k ? 'activo' : '' %>" <%- seccion === k ? 'aria-current="page"' : '' %>>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- ico %></svg><%= txt %></a>
      <% }) %>
    </nav>
    <div class="adm-pie">
      <a href="/" target="_blank" rel="noopener"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v6H4V6h6"/></svg>Ver el sitio</a>
      <div class="adm-usuario"><span class="adm-avatar">FM</span><span><b>Fernando Muñoz</b><small>Administrador</small></span></div>
      <form method="post" action="/admin/salir"><button type="submit" class="adm-salir">Cerrar sesión</button></form>
    </div>
  </aside>
  <main class="adm-principal">
    <% if (typeof aviso !== 'undefined' && aviso) { %><div class="aviso" role="status"><%= aviso %></div><% } %>
